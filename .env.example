# *============================================================*
# === === === === === === 环境配置文件 === === === === === === ===
# *============================================================*

# 服务启动端口与调试开关
SERVER_PORT=
SERVER_DEBUG=

# 安全认证（密钥长度不小于64位）
AUTH_SECRET_KEY=""

# 第三方迁移用户和应用校验地址
THIRD_PARTY_USER_AUTH_URL=""
THIRD_PARTY_SYNC_APPS_URL=""

# MySQL
DATABASE_USERNAME=""
DATABASE_PASSWORD=""
DATABASE_HOST=""
DATABASE_PORT=""
DATABASE_NAME=""

# Redis
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_HOST=""
REDIS_PORT=""

# Celery Redis 库号
CELERY_BROKER_DB=
CELERY_BACKEND_DB=
CELERY_REDBEAT_DB=

# Oracle Instance Client
# 连接模式(thick/thin): thin不兼容11g/部分12.1；
# 连11g需InstantClient19；Client21仅支持DB12.1+，Client23仅支持DB19+
ORACLE_CLIENT_MODE=thick
# Oracle Instant Client目录：MacOS/Windows一般必填；Linux可用ldconfig/LD_LIBRARY_PATH时可留空
ORACLE_CLIENT_PATH=

# 历史日志保留天数：启动时按最后修改时间清理应用/Celery 日志文件；0=不清理
LOGGER_RETENTION_DAYS=30

# 通用AI模型：仅用于项目接口文档备注中的枚举值抽取，ESB不使用
# 未配置API Key前保持false，密钥只填写在本地.env或部署环境变量中
ENUM_AI_EXTRACTION_ENABLED=false
# 模型必须配置在列表中，并按数组顺序进行故障转移；单模型也使用只含一项的列表
# response_format_type支持json_schema和json_object，按模型接口能力选择
# 示例：[{"name":"primary","api_key":"...","base_url":"https://ai.example.com/v1","model_name":"model-a","response_format_type":"json_schema","timeout_seconds":20,"max_retries":0}]
ENUM_AI_MODELS=[]
ENUM_AI_BATCH_SIZE=20
ENUM_AI_BATCH_MAX_CHARS=12000
ENUM_AI_MAX_CONCURRENCY=2
ENUM_AI_TOTAL_TIMEOUT_SECONDS=60
ENUM_AI_MAX_COMPLETION_TOKENS=8192

# Claude Agent SDK：数据生成模块的智能生成分支
# 未配置Bearer Token前保持false；Token只填写在本地.env或部署环境变量中
CLAUDE_AGENT_ENABLED=false
CLAUDE_AGENT_AUTH_TOKEN=""
# 使用Anthropic官方接口时留空；代理地址必须使用HTTPS
CLAUDE_AGENT_BASE_URL=""
CLAUDE_AGENT_WORKSPACE_ID=""
CLAUDE_AGENT_MODEL="sonnet"
CLAUDE_AGENT_MAX_TURNS=30
CLAUDE_AGENT_MAX_BUDGET_USD=2.0
# 必须小于Celery数据生成任务的总超时时间
CLAUDE_AGENT_TIMEOUT_SECONDS=240
# SDK默认使用包内置CLI，只有明确指定外部CLI时才填写
CLAUDE_AGENT_CLI_PATH=""
