# 安全认证
AUTH_SECRET_KEY=""
AUTH_TEMPORARY_TOKEN=""

# MySQL（生产环境）
DATABASE_HOST=""
DATABASE_PORT=""
DATABASE_NAME=""
DATABASE_USERNAME=""
DATABASE_PASSWORD=""

# MySQL（开发环境）
DEV_DATABASE_HOST=""
DEV_DATABASE_PORT=""
DEV_DATABASE_NAME=""
DEV_DATABASE_USERNAME=""
DEV_DATABASE_PASSWORD=""

# Redis（生产/开发）
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_HOST=""
# REDIS_PASSWORD=""
# REDIS_HOST=""
REDIS_PORT=""

# Celery（生产环境）
CELERY_BROKER_DB=
CELERY_BACKEND_DB=
CELERY_REDBEAT_DB=

# Celery（开发环境）
DEV_CELERY_BROKER_DB=
DEV_CELERY_BACKEND_DB=
DEV_CELERY_REDBEAT_DB=

# Oracle Instance Client
# 连接模式(thick/thin): thin不兼容11g/部分12.1；连11g需InstantClient19；Client21仅支持DB12.1+，Client23仅支持DB19+
ORACLE_CLIENT_MODE=thick
# Oracle Instant Client目录：MacOS/Windows一般必填；Linux可用ldconfig/LD_LIBRARY_PATH时可留空
ORACLE_CLIENT_PATH=

# 通用AI模型：仅用于项目接口文档备注中的枚举值抽取，ESB不使用
# 未配置API Key前保持false，密钥只填写在本地.env或部署环境变量中
ENUM_AI_EXTRACTION_ENABLED=false
# 模型必须配置在列表中，并按数组顺序进行故障转移；单模型也使用只含一项的列表
# response_format_type支持json_schema和json_object，按模型接口能力选择
# 示例：[{"name":"primary","api_key":"...","base_url":"https://ai.example.com/v1","model_name":"model-a","response_format_type":"json_schema","timeout_seconds":20,"max_retries":0}]
ENUM_AI_MODELS=[]
ENUM_AI_BATCH_SIZE=20
ENUM_AI_BATCH_MAX_CHARS=12000
ENUM_AI_MAX_CONCURRENCY=2
ENUM_AI_TOTAL_TIMEOUT_SECONDS=60
ENUM_AI_MAX_COMPLETION_TOKENS=8192